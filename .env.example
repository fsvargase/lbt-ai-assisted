# Copy to .env and fill with real values. Never commit .env.

# Database (PostgreSQL). Pooled URL for runtime, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth secret. Generate with: npx auth secret
AUTH_SECRET=""

# Google reCAPTCHA v3. Site key is public (inlined in the client bundle);
# secret key is server-only and must never reach a Client Component.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Minimum passing score (0.0 - 1.0). Optional; defaults to 0.5.
RECAPTCHA_MIN_SCORE="0.5"
# Local/e2e only: set to "true" to bypass reCAPTCHA verification. Ignored in
# production. Never enable in a production environment.
RECAPTCHA_BYPASS="false"

# Public site URL used for canonical URLs, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="https://www.luxurybudgettransport.com"
