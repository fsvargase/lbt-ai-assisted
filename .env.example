# Copy to .env and fill with real values. Never commit .env.

# Database (PostgreSQL). Pooled URL for runtime, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth secret. Generate with: npx auth secret
AUTH_SECRET=""

# Public site URL used for canonical URLs, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="https://www.luxurybudgettransport.com"
